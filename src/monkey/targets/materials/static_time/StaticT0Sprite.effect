CCEffect %{
  techniques:
  - passes:
    - vert: monkey-static-t0-vs:vert
      frag: monkey-static-t0-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState:
        cullMode: none
      properties:
        sourceTimeSeconds: { value: 0.0 }
        sourceScalar0: { value: 0.0 }
        sourceScalar1: { value: 0.0 }
        sourceScalar2: { value: 0.0 }
        sourceScalar3: { value: 0.0 }
        sourceScalar4: { value: 0.0 }
        sourceScalar5: { value: 0.0 }
        sourceScalar6: { value: 0.0 }
        sourceColor0: { value: [1.0, 1.0, 1.0, 1.0], editor: { type: color } }
}%

CCProgram monkey-static-t0-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  #if SAMPLE_FROM_RT
    #include <common/common-define>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec4 v_color;
  out vec2 v_uv;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif
    v_uv = a_texCoord;
    #if SAMPLE_FROM_RT
      CC_HANDLE_RT_SAMPLE_FLIP(v_uv);
    #endif
    v_color = a_color;
    return pos;
  }
}%

CCProgram monkey-static-t0-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec4 v_color;
  in vec2 v_uv;
  #pragma builtin(local)
  layout(set = 2, binding = 11) uniform sampler2D cc_spriteTexture;
  uniform SourceInputs {
    float sourceTimeSeconds;
    float sourceScalar0;
    float sourceScalar1;
    float sourceScalar2;
    float sourceScalar3;
    float sourceScalar4;
    float sourceScalar5;
    float sourceScalar6;
    vec4 sourceColor0;
  };
  const float MONKEY_STATIC_SOURCE_TIME_SECONDS = 0.0;
  float alphaTestThreshold() { return 0.5; }
  void alphaTest (in vec4 color) {
    #if USE_ALPHA_TEST
      if (color.a < alphaTestThreshold()) discard;
    #endif
  }
  vec4 frag () {
    vec4 o = vec4(1.0);
    #if USE_TEXTURE
      vec4 textureColor = CCSampleWithAlphaSeparated(cc_spriteTexture, v_uv);
      #if INPUT_IS_GAMMA
        o.rgb *= textureColor.rgb * textureColor.rgb;
        o.a *= textureColor.a;
      #else
        o *= textureColor;
      #endif
    #endif
    o *= v_color;
    alphaTest(o);
    return o;
  }
}%
